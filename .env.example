# Copie para .env. Nunca envie o client secret pelo chat.
PORT=3000
HOST=127.0.0.1
APP_URL=http://127.0.0.1:3000
# Modo local explícito, permitido somente em loopback. Desative no servidor.
DEV_MODE=false
SAML_ENTRY_POINT=
SAML_IDP_ISSUER=
SAML_IDP_CERT_PATH=
# Os padrões são APP_URL/auth/saml/metadata e APP_URL/auth/saml/acs.
SAML_SP_ENTITY_ID=
WORKSPACE_DOMAIN=casaeterra.com
# Obrigatório em produção: emails separados por vírgula. Todos são administradores neste MVP.
ALLOWED_EMAILS=
DATA_DIR=./data
